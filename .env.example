# ======================================================================
#  SISTEMA DE GESTÃO PARA BARBEARIAS — configuração
# ======================================================================
#  Como usar:
#   1) copie este arquivo para ".env"  (na hospedagem: Gerenciador de
#      Arquivos > clicar em .env.example > Copiar > .env)
#   2) abra http://seudominio.com.br/install e siga o assistente — ele
#      preenche banco, nome da barbearia e usuário administrador sozinho.
#   3) se editar este arquivo manualmente, rode depois:
#      php artisan config:clear
# ----------------------------------------------------------------------

# ---------- Aplicação ----------
APP_NAME="Barbearia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------- Dados da barbearia ----------
# Aparecem no site público, na agenda online e nos comprovantes de venda.
BARBEARIA_NOME="Barbearia"
BARBEARIA_TELEFONE="(98) 99999-0000"
BARBEARIA_EMAIL="contato@suaabarbearia.com.br"
BARBEARIA_ENDERECO="Rua Exemplo, 123 - Centro"
BARBEARIA_CIDADE="São Luís - MA"
BARBEARIA_INSTAGRAM="@suabarbearia"
BARBEARIA_WHATSAPP="98999990000"

# ---------- Agenda / agendamento online ----------
AGENDA_ABERTURA=09:00
AGENDA_FECHAMENTO=20:00
# Intervalo entre os horários oferecidos (em minutos): 10, 15, 20, 30, 45 ou 60
AGENDA_INTERVALO=30
# Dias em que não atende: 0=domingo, 1=segunda, 2=terça, 3=quarta, 4=quinta, 5=sexta, 6=sábado
AGENDA_DIAS_FECHADOS=0
# Minutos de antecedência mínima para agendar (ex.: 60 = até 1h antes)
AGENDA_ANTECEDENCIA_MINIMA=60
# Quantos dias à frente o cliente consegue ver no site
AGENDA_DIAS_VISIVEIS=30

# ---------- Regras de negócio ----------
# Comissão padrão (%) quando o profissional não tem um percentual próprio
COMISSAO_PADRAO=40
# Pagar comissão também sobre produtos vendidos (true/false)
COMISSAO_PRODUTOS=false
# Prazo (dias) para receber vendas feitas no fiado
PRAZO_FIADO_DIAS=30
# Itens por página nas listagens do painel
PAGINACAO_POR_PAGINA=15
# Impedir venda de produto sem saldo no estoque (true/false)
BLOQUEAR_VENDA_SEM_ESTOQUE=true

# ---------- Administrador ----------
# Usado pelo "php artisan db:seed" e pelo instalador na primeira execução.
ADMIN_NOME="Administrador"
ADMIN_EMAIL=admin@suaabarbearia.com.br
ADMIN_PASSWORD=admin123
# true = inclui clientes, serviços, produtos e vendas de exemplo para conhecer o sistema
DEMO_DATA=false

# ---------- Banco de dados ----------
# mysql = recomendado em hospedagem (cPanel). sqlite = arquivo local, bom para testar.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=barbearia
DB_USERNAME=usuario_banco
DB_PASSWORD=

# ---------- Sessão, cache e fila ----------
# Sessão guardada no banco (tabela "sessions", criada pela instalação): funciona em
# qualquer hospedagem, sem depender de permissão de escrita em pasta nenhuma.
# Se preferir arquivos, troque para SESSION_DRIVER=file.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Nome do cookie de sessão (não depende do nome da barbearia: trocar o nome
# em BARBEARIA_NOME não desloga os usuários)
SESSION_COOKIE=barbearia_session

CACHE_STORE=file
# CACHE_PREFIX=barbearia_cache_
# "sync" = sem servidor de fila (tudo roda na hora). É o ideal em hospedagem compartilhada.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---------- E-mail (opcional) ----------
# "log" apenas grava as mensagens em storage/logs. Para enviar de verdade,
# peça os dados SMTP à sua hospedagem e troque MAIL_MAILER para "smtp".
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.suaabarbearia.com.br
MAIL_PORT=587
MAIL_USERNAME=contato@suaabarbearia.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contato@suaabarbearia.com.br"
MAIL_FROM_NAME="${APP_NAME}"
